---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <Navbar />

    <main class="hero" id="Hero">
        <div class="hero__grid">
            <div class="hero__content reveal">
                <p class="eyebrow">Fruty Coloriss</p>
                <h1 class="hero__title">
                    Dulzura, frescura y <em>creatividad</em> en cada postre
                </h1>
                <p class="hero__message">
                    Elaboramos postres únicos con ingredientes frescos, pensados
                    para acompañar tus momentos especiales.
                </p>
            </div>
            <div class="hero__image reveal" style="--index: 1">
                <img src="/oso.jpeg" alt="Postre de oso - Fruty Coloriss" />
            </div>
        </div>
    </main>

    <section id="AboutUs" class="about">
        <div class="section__header reveal">
            <p class="eyebrow">Quienes somos</p>
            <h2 class="section__title">
                Historias dulces hechas <em>a mano</em>
            </h2>
        </div>

        <div class="about__grid">
            <div class="about__image reveal">
                <img src="/About us.jpeg" alt="Postres Fruty Coloriss" />
            </div>
            <div class="about__content reveal" style="--index: 1">
                <p class="about__text">
                    Somos una empresa dedicada a la elaboración y
                    comercialización de postres innovadores, combinando calidad,
                    creatividad y frescura. Trabajamos con ingredientes
                    seleccionados para ofrecer productos que satisfagan las
                    expectativas de nuestros clientes y acompañen momentos
                    especiales.
                </p>
                <ul class="about__tags">
                    <li class="tag tag--pink">Ingredientes frescos</li>
                    <li class="tag tag--blue">Creatividad</li>
                    <li class="tag tag--orange">Calidad</li>
                </ul>
            </div>
        </div>

        <div class="about__values">
            <div class="value-card value-card--pink reveal">
                <div class="value-card__meta">
                    <span class="value-card__dot"></span>
                    <span class="value-card__index">01</span>
                </div>
                <h3 class="value-card__title">Misión</h3>
                <p class="value-card__text">
                    Producir y comercializar tortas con ingredientes naturales e
                    innovadores, brindando productos de calidad que se adapten a
                    las celebraciones, con un servicio eficiente, creativo y
                    responsable.
                </p>
            </div>
            <div
                class="value-card value-card--orange reveal"
                style="--index: 1"
            >
                <div class="value-card__meta">
                    <span class="value-card__dot"></span>
                    <span class="value-card__index">02</span>
                </div>
                <h3 class="value-card__title">Visión</h3>
                <p class="value-card__text">
                    Ser una empresa líder en postres para el año 2028,
                    reconocida por su innovación, calidad y presencia en el
                    mercado gastronómico con opciones saludables y para
                    celebraciones.
                </p>
            </div>
        </div>
    </section>

    <section id="Productos" class="products">
        <div class="section__header reveal">
            <p class="eyebrow">Productos</p>
            <h2 class="section__title">Nuestros Postres</h2>
        </div>
        <div class="products__grid">
            <a
                target="_blank"
                href="https://wa.me/573013275340?text=Hola%20Fruty%20Coloriss%2C%20quiero%20hacer%20un%20pedido%20de%20un%20Postre%20Personalizado."
                class="product-card reveal"
            >
                <div class="product-card__image">
                    <img
                        src="/pequeno.jpeg"
                        alt="Postre Personalizado - Fruty Coloriss"
                    />
                </div>
                <div class="product-card__body">
                    <h3 class="product-card__title">Postre de Perzonalizado</h3>
                    <p class="product-card__text">
                        Elige tus frutas, sabores y colores favoritos y crea un
                        postre único, preparado especialmente para ti...
                    </p>
                </div>
            </a>
            <a
                href="https://wa.me/573013275340?text=Hola%20Fruty%20Coloriss%2C%20quiero%20hacer%20un%20pedido%20de%20una%20Torta%20Personalizada."
                class="product-card reveal"
                style="--index: 1"
                target="_blank"
            >
                <div class="product-card__image">
                    <img
                        src="/grande.jpeg"
                        alt="Torta Personalizada Fruty Coloriss"
                    />
                </div>
                <div class="product-card__body">
                    <h3 class="product-card__title">Torta Personalizada</h3>
                    <p class="product-card__text">
                        Especiales para cumpleaños, reuniones y momentos
                        inolvidables...
                    </p>
                </div>
            </a>
        </div>
    </section>

    <section id="Contacto" class="contact">
        <div class="section__header reveal">
            <p class="eyebrow">Contacto</p>
            <h2 class="section__title">Hablemos de tu próximo postre</h2>
        </div>
        <div class="contact__grid">
            <div class="contact__item reveal">
                <span class="contact__icon-wrap contact__icon-wrap--pink">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M2.25 6.75c0-1.657 1.343-3 3-3h1.372c.516 0 .966.351 1.091.852l.917 3.666a1.125 1.125 0 01-.294 1.061l-1.293 1.293a1.125 1.125 0 00-.263 1.176 12.06 12.06 0 006.442 6.442c.42.163.9.03 1.176-.263l1.293-1.293a1.125 1.125 0 011.06-.294l3.667.917c.5.125.852.575.852 1.091V19.5c0 1.657-1.343 3-3 3h-.75C9.716 22.5 1.5 14.284 1.5 4.5v-.75z"
                        />
                    </svg>
                </span>
                <div>
                    <h3 class="contact__label">WhatsApp</h3>
                    <p class="contact__value">+57 300 000 0000</p>
                </div>
            </div>
            <div class="contact__item reveal" style="--index: 1">
                <span class="contact__icon-wrap contact__icon-wrap--blue">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle
                            cx="17.25"
                            cy="6.75"
                            r="0.75"
                            fill="currentColor"
                            stroke="none"
                        />
                    </svg>
                </span>
                <div>
                    <h3 class="contact__label">Instagram</h3>
                    <p class="contact__value">@Fruty Coloriss</p>
                </div>
            </div>
            <div class="contact__item reveal" style="--index: 2">
                <span class="contact__icon-wrap contact__icon-wrap--orange">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                        />
                    </svg>
                </span>
                <div>
                    <h3 class="contact__label">Ubicación</h3>
                    <p class="contact__value">Ciudad, Colombia</p>
                </div>
            </div>
            <div class="contact__item reveal" style="--index: 3">
                <span class="contact__icon-wrap contact__icon-wrap--pink">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <circle cx="12" cy="12" r="9" />
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 7.5V12l3 1.5"
                        />
                    </svg>
                </span>
                <div>
                    <h3 class="contact__label">Horario</h3>
                    <p class="contact__value">Lun - Sáb: 9:00 am - 6:00 pm</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <p class="footer__text">
            <span class="footer__brand">Fruty Coloriss</span> — Todos los
            derechos reservados
        </p>
    </footer>
</Layout>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    section,
    main {
        width: 100%;
        max-width: 1200px;
        padding: 0 24px;
    }

    /* Shared */

    .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-pink-ink);
        background: var(--color-pink-soft);
        padding: 6px 14px;
        border-radius: 999px;
    }

    .section__header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-align: center;
        margin-bottom: 56px;
    }

    .section__title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--color-ink);
    }

    .section__title em {
        font-style: italic;
        color: var(--color-pink);
    }

    .tag {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 999px;
        list-style: none;
    }

    .tag--pink {
        color: var(--color-pink-ink);
        background: var(--color-pink-soft);
    }

    .tag--blue {
        color: var(--color-blue-ink);
        background: var(--color-blue-soft);
    }

    .tag--orange {
        color: var(--color-orange-ink);
        background: var(--color-orange-soft);
    }

    .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition:
            opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: calc(var(--index, 0) * 100ms);
    }

    .reveal--visible {
        opacity: 1;
        transform: none;
    }

    /* Hero */

    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 120px;
        padding-bottom: 60px;
    }

    .hero__grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 64px;
        width: 100%;
    }

    .hero__content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 22px;
    }

    .hero__title {
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 4.5vw, 3.4rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--color-ink);
    }

    .hero__title em {
        font-style: italic;
        color: var(--color-pink);
    }

    .hero__message {
        color: var(--color-muted);
        font-size: 1.35rem;
        line-height: 1.7;
        max-width: 460px;
    }

    .hero__image img {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid var(--color-border);
        box-shadow: 0 30px 60px -20px rgba(43, 36, 31, 0.15);
    }

    /* About */

    .about {
        margin-top: 40px;
        display: flex;
        flex-direction: column;
    }

    .about__grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 56px;
        align-items: center;
    }

    .about__image img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid var(--color-border);
    }

    .about__content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .about__text {
        color: var(--color-muted);
        font-size: 1.4rem;
        line-height: 1.8;
    }

    .about__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        list-style: none;
    }

    .about__values {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-top: 72px;
    }

    .value-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 36px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .value-card__meta {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .value-card__dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-pink);
    }

    .value-card--orange .value-card__dot {
        background: var(--color-orange);
    }

    .value-card__index {
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: 0.05em;
        color: var(--color-muted);
    }

    .value-card__title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--color-ink);
    }

    .value-card__text {
        color: var(--color-muted);
        font-size: 1.1rem;
        line-height: 1.7;
    }

    /* Products */

    .products {
        margin-top: 120px;
    }

    .products__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        transition:
            border-color 0.3s ease,
            transform 0.3s ease;
    }

    .product-card:hover {
        border-color: var(--color-pink);
        transform: translateY(-4px);
    }

    .product-card__image {
        aspect-ratio: 4 / 3;
    }

    .product-card__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-card__body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .product-card__title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--color-ink);
        margin-top: 4px;
    }

    .product-card__text {
        color: var(--color-muted);
        font-size: 1.1rem;
        line-height: 1.6;
    }

    /* Contact */

    .contact {
        margin-top: 120px;
        margin-bottom: 80px;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--color-border);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        max-width: 760px;
        margin: 0 auto;
    }

    .contact__item {
        background: var(--color-surface);
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 32px;
    }

    .contact__icon-wrap {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .contact__icon-wrap svg {
        width: 20px;
        height: 20px;
    }

    .contact__icon-wrap--pink {
        background: var(--color-pink-soft);
        color: var(--color-pink-ink);
    }

    .contact__icon-wrap--blue {
        background: var(--color-blue-soft);
        color: var(--color-blue-ink);
    }

    .contact__icon-wrap--orange {
        background: var(--color-orange-soft);
        color: var(--color-orange-ink);
    }

    .contact__label {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-ink);
        margin-bottom: 4px;
    }

    .contact__value {
        color: var(--color-muted);
        font-size: 0.95rem;
    }

    /* Footer */

    .footer {
        width: 100%;
        border-top: 1px solid var(--color-border);
        padding: 32px;
        text-align: center;
        color: var(--color-muted);
        font-size: 0.9rem;
    }

    .footer__brand {
        color: var(--color-ink);
        font-weight: 700;
    }

    @media (max-width: 900px) {
        .hero__grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .hero__content {
            align-items: center;
            text-align: center;
        }

        .hero__message {
            max-width: none;
        }

        .about__grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .about__image img {
            max-width: 420px;
            margin: 0 auto;
        }
    }

    @media (max-width: 768px) {
        .about__values {
            grid-template-columns: 1fr;
        }

        .products__grid {
            grid-template-columns: 1fr;
        }

        .contact__grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const revealEls = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("reveal--visible");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.15 },
    );
    revealEls.forEach((el) => observer.observe(el));
</script>
