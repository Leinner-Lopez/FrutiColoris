---
const links = [
    { href: "/#Hero", label: "Inicio" },
    { href: "/#AboutUs", label: "Quienes Somos" },
    { href: "/#Productos", label: "Productos" },
    { href: "/#Contacto", label: "Contacto" },
];
---

<header class="header" id="navbar">
    <div class="header__container">
        <a href="/#Hero" class="header__logo-container">
            <img src="/logo.png" alt="FrutiColoris" />
            <span class="header__title">FrutiColoris</span>
        </a>
        <nav class="header__nav">
            <ul class="header__nav-list">
                {
                    links.map((link) => (
                        <li class="header__nav-item">
                            <a href={link.href} class="nav-link">
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        justify-content: center;
        z-index: 10;
        width: 100%;
        padding: 22px 24px;
        background-color: transparent;
        box-shadow: 0 1px 0 transparent;
        transition:
            background-color 0.4s ease,
            box-shadow 0.4s ease;
    }

    .header-compact {
        background-color: rgba(251, 248, 243, 0.85);
        backdrop-filter: blur(12px);
        box-shadow: 0 1px 0 var(--color-border);
    }

    .header__container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 1200px;
    }

    .header__logo-container {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--color-ink);
        text-decoration: none;
    }

    .header__logo-container img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
    }

    .header__nav-list {
        list-style: none;
        display: flex;
        gap: 32px;
    }

    .nav-link {
        color: var(--color-ink);
        transition: color 0.3s;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        position: relative;
        padding-bottom: 4px;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1.5px;
        background: var(--color-pink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
    }

    .nav-link:hover {
        color: var(--color-pink-ink);
    }

    .nav-link:hover::after {
        transform: scaleX(1);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .header {
            padding: 18px 16px;
        }

        .header__nav-list {
            gap: 16px;
            font-size: 0.85rem;
        }

        .header__title {
            display: none;
        }
    }
</style>

<script>
    const header = document.getElementById("navbar");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 40) {
            header.classList.add("header-compact");
        } else {
            header.classList.remove("header-compact");
        }
    });
</script>
